# Copy to .env and fill in values. Never commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars

# Database
# Local Docker (optional): postgresql://joe:joe@localhost:5433/joe_real_estate_os
#
# Supabase (production / recommended):
# Project: agentcrm (plyzkmerzfmkreqrpynw) — us-east-2
# Dashboard: https://supabase.com/dashboard/project/plyzkmerzfmkreqrpynw/settings/database
# Use the "URI" connection string (Session mode / port 5432) for Prisma migrations,
# or Transaction pooler (port 6543) with ?pgbouncer=true for serverless if needed.
# Prefer the direct connection for Prisma Migrate; use pooler for the app runtime on Vercel.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (migrations):
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.plyzkmerzfmkreqrpynw.supabase.co:5432/postgres

# Optional providers (Phase 1 uses mocks — leave unset)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
